  answers1Text: {fileID: 260386741}
  answers2Text: {fileID: 370526441}
  answers3Text: {fileID: 625231893}
  questionCount: {fileID: 210319734}
  defaultColor: {r: 0, g: 0, b: 0, a: 0}
  audioSource: {fileID: 1410839145}
  rightSound: {fileID: 8300000, guid: 8e7ca39b4a7f1704988b5102d411ece3, type: 3}
  wrongSound: {fileID: 8300000, guid: e2eb4032c421f3b4ca70c1edd9deb057, type: 3}
  startQuizSound: {fileID: 8300000, guid: eaefd850fb6ab4f479a5b836422183a2, type: 3}
  resultText: {fileID: 1329235009}
  questions:
  - question: "\u041A\u0430\u043A \u043F\u0440\u0430\u0432\u0438\u043B\u044C\u043D\u043E
      \u0438 \u0431\u0435\u0437\u043E\u043F\u0430\u0441\u043D\u043E \u043F\u0435\u0440\u0435\u0439\u0442\u0438
      \u0443\u043B\u0438\u0446\u0443?"
    answer0: "A) \u0413\u0434\u0435 \u0437\u0430\u0445\u043E\u0447\u0435\u0442\u0441\u044F"
    answer1: "B) \u0422\u0430\u043C, \u0433\u0434\u0435 \u043D\u0435\u0442 \u043C\u0430\u0448\u0438\u043D"
    answer2: "C) \u041F\u043E \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u043D\u043E\u043C\u0443
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0443!"
    answer3: "D) \u0411\u0435\u0433\u043E\u043C, \u0447\u0442\u043E\u0431\u044B \u0431\u044B\u0441\u0442\u0440\u0435\u0435! "
    rightAnswerId: 2
    questionSound: {fileID: 8300000, guid: 397cb6bf85b4c9b4d9570935caf413b3, type: 3}
  - question: "\u0413\u0434\u0435 \u043C\u044B \u0436\u0434\u0435\u043C \u0430\u0432\u0442\u043E\u0431\u0443\u0441?"
    answer0: "A) \u041F\u0440\u044F\u043C\u043E \u043D\u0430 \u0434\u043E\u0440\u043E\u0433\u0435!"
    answer1: "B) \u041D\u0430 \u043E\u0441\u0442\u0430\u043D\u043E\u0432\u043A\u0435!"
    answer2: "C) \u0412 \u0431\u043B\u0438\u0436\u0430\u0439\u0448\u0435\u043C \u043C\u0430\u0433\u0430\u0437\u0438\u043D\u0435 "
    answer3: "D) \u0414\u043E\u043C\u0430! "
    rightAnswerId: 1
    questionSound: {fileID: 8300000, guid: e200d1ff23d8ee04d81f9df18273a04e, type: 3}
  - question: "\u0410\u0432\u0442\u043E\u0431\u0443\u0441 \u043E\u0431\u0445\u043E\u0434\u0438\u043C..."
    answer0: "A) \u0421\u043F\u0435\u0440\u0435\u0434\u0438, \u0442\u0430\u043A \u0431\u044B\u0441\u0442\u0440\u0435\u0435! "
    answer1: "B) \u0421\u0437\u0430\u0434\u0438, \u0447\u0442\u043E\u0431\u044B \u0432\u0438\u0434\u0435\u0442\u044C
      \u0434\u043E\u0440\u043E\u0433\u0443!"
    answer2: "C) \u0421 \u043B\u044E\u0431\u043E\u0439 \u0441\u0442\u043E\u0440\u043E\u043D\u044B,
      \u0433\u043B\u0430\u0432\u043D\u043E\u0435 - \u043E\u0441\u0442\u043E\u0440\u043E\u0436\u043D\u043E "
    answer3: "D) \u041B\u0443\u0447\u0448\u0435 \u0432\u043E\u043E\u0431\u0449\u0435
      \u043D\u0435 \u043E\u0431\u0445\u043E\u0434\u0438\u0442\u044C"
    rightAnswerId: 1
    questionSound: {fileID: 8300000, guid: ebc349d0307f6e045a05b4107db5b98d, type: 3}
  - question: "\u041D\u0430 \u043A\u0430\u043A\u043E\u0439 \u0446\u0432\u0435\u0442
      \u0441\u0432\u0435\u0442\u043E\u0444\u043E\u0440\u0430 \u043C\u043E\u0436\u043D\u043E
      \u043F\u0435\u0440\u0435\u0445\u043E\u0434\u0438\u0442\u044C \u0434\u043E\u0440\u043E\u0433\u0443?"
    answer0: "A) \u041A\u0440\u0430\u0441\u043D\u044B\u0439"
    answer1: "B) \u041D\u0430\u0439\u0442\u0438 \u043F\u0435\u0440\u0435\u0445\u043E\u0434
      \u0431\u0435\u0437 \u0441\u0432\u0435\u0442\u043E\u0444\u043E\u0440\u0430"
    answer2: "C) \u0417\u0435\u043B\u0435\u043D\u044B\u0439"
    answer3: "D) \u041D\u0430 \u043B\u044E\u0431\u043E\u0439, \u0435\u0441\u043B\u0438
      \u043D\u0435\u0442 \u043C\u0430\u0448\u0438\u043D "
    rightAnswerId: 2
    questionSound: {fileID: 8300000, guid: 3f9c232adb438364187537098df1be52, type: 3}
  - question: "\u041A\u0430\u043A \u0432 \u043D\u0430\u0440\u043E\u0434\u0435 \u043D\u0430\u0437\u044B\u0432\u0430\u044E\u0442
      \u043F\u0435\u0448\u0435\u0445\u043E\u0434\u043D\u044B\u0439 \u043F\u0435\u0440\u0435\u0445\u043E\u0434?"
    answer0: "A) \u041B\u0435\u0441\u0435\u043D\u043A\u0430"
    answer1: "B) \u041A\u043B\u0430\u0432\u0438\u0448\u0438"
    answer2: "C) \u041A\u043B\u0435\u0442\u043A\u0430"
    answer3: "D) \u0417\u0435\u0431\u0440\u0430"
    rightAnswerId: 3
    questionSound: {fileID: 8300000, guid: 7f413ca892dde9d44a80dda6a36ea81f, type: 3}
